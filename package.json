{
  "name": "myfridge",
  "version": "1.0.0",
  "description": "Виртуальный холодильник: сроки годности, напоминания и рецепты",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json --noEmit",
    "start": "node build-server/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:recipes": ".venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "setup:recipes": "python3 -m venv .venv && .venv/bin/pip install -r recipes/requirements.txt"
  },
  "dependencies": {
    "react": "^19.2.0", "react-dom": "^19.2.0", "lucide-react": "^0.468.0",
    "express": "^5.1.0", "luxon": "^3.7.2", "zod": "^4.1.0", "web-push": "^3.6.7", "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3", "vite": "^7.2.0", "@vitejs/plugin-react": "^5.1.0",
    "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@types/node": "^24.0.0",
    "@types/express": "^5.0.0", "@types/luxon": "^3.7.0", "@types/web-push": "^3.6.4",
    "tsx": "^4.20.0", "concurrently": "^9.2.0"
  },
  "private": true
}
